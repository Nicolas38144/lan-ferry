# Copy to .env and adjust. The file is loaded when the server starts.
FILE_TRANSFER_PORT=8080
FILE_TRANSFER_HOST=0.0.0.0
# Empty: use ~/FileTransfer.
FILE_TRANSFER_DESTINATION=
FILE_TRANSFER_CONCURRENCY=2
# Empty: no application-level file size limit.
FILE_TRANSFER_MAX_BYTES=
FILE_TRANSFER_AUTH=true
